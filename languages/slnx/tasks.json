[
  {
    "label": "Restore Current Solution",
    "command": "dotnet",
    "args": [
      "restore",
      "'$ZED_FILE'"
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "shell": "system"
  },
  {
    "label": "Build Current Solution",
    "command": "dotnet",
    "args": [
      "build",
      "'$ZED_FILE'"
    ],
    "reveal": "no_focus",
    "hide": "never",
    "show_command": false,
    "show_summary": false
  }
]
