[
  {
    "label": "Build Current Project",
    "command": "dotnet build",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "shell": "system"
  },
  {
    "label": "Run Current Project",
    "command": "dotnet",
    "args": [
      "run",
      "--project",
      "$ZED_FILE"
    ],
    "reveal": "no_focus",
    "hide": "never",
    "env": {
      "DOTNET_FILE": "$ZED_FILE"
    },
    "show_command": false,
    "show_summary": false
  },
  {
    "label": "Test Current Project",
    "command": "dotnet",
    "args": [
      "test",
      "$ZED_FILE"
    ],
    "reveal": "no_focus",
    "hide": "never",
    "env": {
      "DOTNET_FILE": "$ZED_FILE"
    },
    "show_command": false,
    "show_summary": false
  },
  {
    "label": "Build Solution",
    "command": "dotnet build",
    "args": [
      "$ZED_WORKTREE_ROOT"
    ],
    "reveal": "no_focus",
    "hide": "never",
    "show_command": false,
    "show_summary": false
  },
  {
    "label": "Restore Current Project",
    "command": "dotnet restore",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "shell": "system"
  }
]
